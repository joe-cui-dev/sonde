# ── Credentials ───────────────────────────────────────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
# https://app.tavily.com  (tvly-...)
TAVILY_API_KEY=tvly-REPLACE_ME

# ── Models (OpenRouter slugs — verify at https://openrouter.ai/models) ────────
# Plans, decides what to search, reads evidence. Use a strong model.
SONDE_PLANNER_MODEL=z-ai/glm-5.3-flash
# Writes the final cited report. Can be the same, or cheaper.
SONDE_WRITER_MODEL=z-ai/glm-5.3-flash
# Writes prose without retrieval or JSON-schema constraints. When unset it uses
# SONDE_WRITER_MODEL, but its provider routing is deliberately not pinned.
SONDE_WRITE_MODEL=
# Writing may deliberate; unlike report transcription its independent default is medium.
# One of: default | none | minimal | low | medium | high | xhigh
SONDE_WRITE_REASONING_EFFORT=low

# How hard the writer may think. It transcribes and quote-checks rather than
# deliberating, so this is capped: left to the provider, one run burned 22k
# reasoning tokens to write a 2.5k-token report — 8 minutes and 5x the cost of
# the same result. "default" hands the decision back to the provider.
# One of: default | none | minimal | low | medium | high | xhigh
SONDE_WRITER_REASONING_EFFORT=low

# Which OpenRouter upstreams may write the report, in preference order and with
# fallbacks off. Blank (the default) lets OpenRouter route freely: it spreads the
# model across every provider serving it, and they do not all honour the report's
# JSON schema when the response is streamed — a run that draws an unlucky one
# loses its report after paying for the retrieval behind it. Pinning is the fix,
# but a list is only ever valid for ONE writer model, so there is no default here
# to inherit: derive your own and re-derive it whenever SONDE_WRITER_MODEL changes.
#
#   curl https://openrouter.ai/api/v1/models/<SONDE_WRITER_MODEL>/endpoints
#
# Keep the providers whose supported_parameters include "structured_outputs",
# then confirm the list with `sonde doctor`. Router aliases (ids starting with
# "~") expose no endpoints and cannot be pinned at all — leave this blank for one.
SONDE_WRITER_PROVIDERS=

# ── Budget gates (a run stops gracefully at the FIRST limit reached) ──────────
SONDE_MAX_STEPS=16
SONDE_MAX_USD=0.20
SONDE_MAX_TOKENS=400000
SONDE_MAX_SEARCH_CREDITS=60
# Covers the whole run, writer included. Retrieval stops with 15% of it still
# unspent so the report always has time to be written; a run that reaches this
# limit mid-report loses the report, so keep it consistent with MAX_STEPS —
# roughly 25s per step plus two minutes for the writer.
SONDE_MAX_WALL_MS=900000

# ── Retrieval ────────────────────────────────────────────────────────────────
SONDE_SEARCH_PROVIDER=tavily
SONDE_SEARCH_DEPTH=advanced
SONDE_EXTRACT_DEPTH=basic

# ── Storage ──────────────────────────────────────────────────────────────────
SONDE_DB_PATH=.sonde/sonde.db
# Where `sonde write` saves each finished piece as markdown.
SONDE_WRITING_DIR=.sonde/writing
# Styles of your own, added to the built-in ones; a style named for a built-in
# replaces it. Absent by default — copy styles.example.json here to start.
SONDE_STYLES_FILE=.sonde/styles.json
SONDE_CHARACTERS_FILE=.sonde/characters.json
SONDE_CACHE_TTL_HOURS=168

# ── Video ─────────────────────────────────────────────────────────────────────
# Image-to-video through OpenRouter's video API. Only models Sonde has a profile
# for can be used — one it cannot price is one it cannot gate. Check with doctor.
# Profiled: bytedance/seedance-2.0-mini, minimax/hailuo-3-max.
SONDE_VIDEO_MODEL=bytedance/seedance-2.0-mini
# A video run is priced before submission and refused above this. Once a job is
# submitted nothing can stop it, so this is the only gate it has.
SONDE_VIDEO_MAX_USD=1
# Where clips are saved.
SONDE_VIDEO_DIR=.sonde/video
# How long `sonde video` waits before handing back the run id. The job keeps
# running (and billing); `sonde video fetch <run-id>` collects it later.
SONDE_VIDEO_MAX_WAIT_MS=600000

# ── Observability ────────────────────────────────────────────────────────────
# silent | info | debug
SONDE_LOG_LEVEL=info
# Sent to OpenRouter for attribution on their dashboard/leaderboards.
SONDE_APP_URL=https://github.com/xiaozhoucui/sonde
SONDE_APP_TITLE=Sonde
